# Zerodha KiteConnect Credentials
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_USER_ID=your_user_id_here
ZERODHA_PASSWORD=your_password_here
ZERODHA_TOTP_SECRET=your_totp_secret_here   # Base32 secret from Zerodha 2FA setup

# Trading Configuration
TOTAL_CAPITAL=5000          # INR - Starting capital
STOP_LOSS_PCT=5.0           # % of total capital as max daily loss
MAX_TRADE_CAPITAL_PCT=40    # Max % of capital in a single trade
MAX_OPEN_POSITIONS=3        # Maximum simultaneous open trades

# Trading bot notifications (optional)
TELEGRAM_BOT_TOKEN=         # Optional: Telegram bot token for trade alerts
TELEGRAM_CHAT_ID=           # Optional: Your Telegram chat ID for trade alerts

# ── Telegram Stock Alert Bot ───────────────────────────────────────────────
# Get a bot token from @BotFather on Telegram
ALERT_BOT_TOKEN=            # Required: Token for the stock alert bot
# Get your chat ID by messaging @userinfobot on Telegram
ALERT_CHAT_ID=              # Required: Your personal chat ID (enables push alerts)
