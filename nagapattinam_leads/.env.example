# ─────────────────────────────────────────────────────────────
#  Nagapattinam RO Lead Generation Pipeline — Environment File
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── data.gov.in ──────────────────────────────────────────────
# Register free at: https://data.gov.in/user/register
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# ── Google Sheets ─────────────────────────────────────────────
# Path to the service-account JSON downloaded from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
# The exact name of the Google Sheet to write to
GOOGLE_SHEET_NAME=Nagapattinam RO - Live Leads

# ── Email alert (SMTP) ────────────────────────────────────────
ALERT_EMAIL_SENDER=your_bank_email@iob.in
ALERT_EMAIL_PASSWORD=your_app_password_here
ALERT_EMAIL_RECIPIENT=rm_nagapattinam@iob.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── WhatsApp alert (Twilio — optional) ───────────────────────
# Leave blank to disable WhatsApp alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# ── Pipeline behaviour ────────────────────────────────────────
# How many seconds to wait between API calls (be polite to servers)
API_RATE_LIMIT_SECONDS=2
# Maximum retries on network failure
MAX_RETRIES=3
