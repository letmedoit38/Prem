# ============================================================
#  STOCK ALERT BOT - CONFIGURATION
#  Copy this file to ".env" and fill in your values.
# ============================================================


# ── Twilio (WhatsApp sender + receiver) ──────────────────────
#
#  Sign up free at: https://www.twilio.com/try-twilio
#  After signing up:
#    Dashboard → Account Info → copy Account SID and Auth Token

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#  Twilio WhatsApp Sandbox number (default, don't change unless you
#  have a paid approved WhatsApp sender):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

#  Your WhatsApp number with country code:
WHATSAPP_TO=whatsapp:+919486196299


# ── ngrok (creates a public URL so Twilio can send you replies) ──
#
#  Sign up free at: https://ngrok.com
#  After signing up: Dashboard → Your Authtoken → Copy

NGROK_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Optional settings ────────────────────────────────────────
FLASK_PORT=5000
