# ── Your WhatsApp number (with country code, no + or spaces) ──────────────
#  Example for India: 919486196299
WHATSAPP_PHONE=919486196299

# ── CallMeBot API key ─────────────────────────────────────────────────────
#
#  One-time setup (takes ~30 seconds):
#
#  1. Open WhatsApp and save this number as a contact:
#       +34 644 21 84 22   (name it "CallMeBot")
#
#  2. Send it this EXACT message on WhatsApp:
#       I allow callmebot to send me messages
#
#  3. Wait — you will receive your API key via WhatsApp in a few seconds.
#
#  4. Paste it below:

CALLMEBOT_APIKEY=
